#!/usr/bin/env bash
# @file run
# @brief Builds when necessary and launches the host simulator.

set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
build_dir="${BUILD_DIR:-${project_root}/.build}"
simulator="${build_dir}/rtos_sim"

if [[ ! -x "${simulator}" ]]; then
    "${project_root}/build"
fi

cd "${project_root}"
exec "${simulator}" "$@"
